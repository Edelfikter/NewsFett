# Upstash Redis (get from https://console.upstash.com)
REDIS_URL=https://your-redis-url.upstash.io
REDIS_TOKEN=your_redis_token_here

# Geocoding (OpenStreetMap Nominatim - set to your app name/email)
GEOCODE_USER_AGENT=NewsFett/1.0 (your@email.com)

# Optional: cron secret to protect /api/poll from public calls
CRON_SECRET=replace_with_random_secret
